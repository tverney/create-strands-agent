import 'dotenv/config';
import express from 'express';
import { v4 as uuidv4 } from 'uuid';
import { Agent } from '@strands-agents/sdk';
import { AgentCard, Message, AGENT_CARD_PATH } from '@a2a-js/sdk';
import {
  AgentExecutor,
  RequestContext,
  ExecutionEventBus,
  DefaultRequestHandler,
  InMemoryTaskStore,
} from '@a2a-js/sdk/server';
import { agentCardHandler, jsonRpcHandler, restHandler, UserBuilder } from '@a2a-js/sdk/server/express';
import agentCardConfig from './agent-card.json' with { type: 'json' };

/**
 * A2A server entry point.
 *
 * Exposes the Strands agent over the Agent-to-Agent (A2A) protocol so that
 * other A2A-compatible agents can discover and communicate with it.
 *
 * ──────────────────────────────────────────────────────────────────────────────
 * Customization:
 *
 *   - Edit `agent-card.json` to update the agent's name, description,
 *     capabilities, and skills.
 *   - Modify the `agent` configuration below to add tools, change the model,
 *     or update the system prompt.
 *   - Change the port by setting the PORT environment variable.
 *   - See the A2A JS SDK docs for streaming, push notifications, and gRPC:
 *     https://github.com/a2aproject/a2a-js
 * ──────────────────────────────────────────────────────────────────────────────
 */

const PORT = parseInt(process.env.PORT ?? '3000', 10);

// ── Strands Agent ───────────────────────────────────────────────────────────
const agent = new Agent({
  systemPrompt: 'You are a helpful AI assistant exposed via the A2A protocol.',
});

// ── A2A Agent Card ──────────────────────────────────────────────────────────
const card: AgentCard = {
  ...agentCardConfig,
  url: `http://localhost:${PORT}/a2a/jsonrpc`,
  additionalInterfaces: [
    { url: `http://localhost:${PORT}/a2a/jsonrpc`, transport: 'JSONRPC' },
    { url: `http://localhost:${PORT}/a2a/rest`, transport: 'HTTP+JSON' },
  ],
};

// ── Agent Executor ──────────────────────────────────────────────────────────
class StrandsA2AExecutor implements AgentExecutor {
  async execute(requestContext: RequestContext, eventBus: ExecutionEventBus): Promise<void> {
    const { userMessage } = requestContext;

    // Extract text from the user message
    const inputText = userMessage.parts
      .filter((p): p is { kind: 'text'; text: string } => p.kind === 'text')
      .map((p) => p.text)
      .join('\n');

    // Invoke the Strands agent
    const result = await agent.invoke(inputText);

    // Build and publish the response message
    const responseMessage: Message = {
      kind: 'message',
      messageId: uuidv4(),
      role: 'agent',
      parts: [{ kind: 'text', text: String(result) }],
      contextId: requestContext.contextId,
    };

    eventBus.publish(responseMessage);
    eventBus.finished();
  }

  cancelTask = async (): Promise<void> => {};
}

// ── Server Setup ────────────────────────────────────────────────────────────
const executor = new StrandsA2AExecutor();
const requestHandler = new DefaultRequestHandler(
  card,
  new InMemoryTaskStore(),
  executor,
);

const app = express();

app.use(`/${AGENT_CARD_PATH}`, agentCardHandler({ agentCardProvider: requestHandler }));
app.use('/a2a/jsonrpc', jsonRpcHandler({ requestHandler, userBuilder: UserBuilder.noAuthentication }));
app.use('/a2a/rest', restHandler({ requestHandler, userBuilder: UserBuilder.noAuthentication }));

app.listen(PORT, () => {
  console.log(`A2A server running at http://localhost:${PORT}`);
  console.log(`Agent card: http://localhost:${PORT}/.well-known/agent.json`);
  console.log(`JSON-RPC:   http://localhost:${PORT}/a2a/jsonrpc`);
  console.log(`REST:       http://localhost:${PORT}/a2a/rest`);
});
