# ─── Base Configuration ───────────────────────────────────────────────────────
# AWS credentials for Strands SDK (uses Bedrock by default)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model configuration
STRANDS_MODEL_ID=us.anthropic.claude-sonnet-4-20250514
<% if (hasAgentCore) { %>
# ─── AgentCore Configuration ─────────────────────────────────────────────────
# AWS account and region for AgentCore deployment
AGENTCORE_REGION=us-east-1
AGENTCORE_ENDPOINT=
AGENTCORE_AGENT_NAME=<%= projectName %>
<% } %>
