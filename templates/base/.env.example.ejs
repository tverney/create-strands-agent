# ─── AWS Credentials ──────────────────────────────────────────────────────────
# The Strands SDK defaults to Amazon Bedrock with Claude Sonnet 4.6.
# Configure your AWS credentials below, or use `aws configure`, or IAM roles.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ─── Model Configuration (optional) ──────────────────────────────────────────
# Override the default model by uncommenting and setting a model ID:
# STRANDS_MODEL_ID=global.anthropic.claude-sonnet-4-6
<% if (hasAgentCore) { %>
# ─── AgentCore Configuration ─────────────────────────────────────────────────
# AWS account and region for AgentCore deployment
AGENTCORE_REGION=us-east-1
AGENTCORE_ENDPOINT=
AGENTCORE_AGENT_NAME=<%= projectName %>
<% } %>
